<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.MainController">
            
    <top>
    	<VBox spacing="5">
    	
    		<TextField fx:id="txtReferencia" promptText="Referencia"/>
            <TextField fx:id="txtNombre" promptText="Nombre"/>
            <TextField fx:id="txtCategoria" promptText="Categoría"/>
            <TextField fx:id="txtPrecioCompra" promptText="Precio compra"/>
            <TextField fx:id="txtValorActual" promptText="Valor actual"/>
                      
            	<HBox spacing="10">
    				<Button text="Guardar"
            				onAction="#guardarPlaymobil"/>

    				<Button text="Modificar"
            				onAction="#modificarPlaymobil"/>
            		
            		<Button text="Eliminar"
            				onAction="#eliminarPlaymobil"/>
				</HBox>
				        
    	</VBox>
    </top>

    <center>
        <TableView fx:id="tablaPlaymobil">
        
        	<columns>
        		<TableColumn fx:id="colReferencia" text="Referencia"/>
                <TableColumn fx:id="colNombre" text="Nombre"/>
                <TableColumn fx:id="colCategoria" text="Categoría"/>
                <TableColumn fx:id="colPrecio" text="Precio Compra"/>
                <TableColumn fx:id="colValor" text="Valor Actual"/>
            </columns>
            
        </TableView> 
    </center>

</BorderPane>