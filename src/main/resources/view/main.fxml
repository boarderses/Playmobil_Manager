<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>

		<BorderPane prefHeight="900" prefWidth="1450" xmlns="http://javafx.com/javafx/21" 
					xmlns:fx="http://javafx.com/fxml/1" 
					fx:controller="controller.MainController">
		   <center>
		      <HBox alignment="TOP_CENTER" spacing="35">
		      	<padding>
				    <Insets top="20" right="25" bottom="20" left="25"/>
				</padding>
		         <children>
		            <VBox spacing="10.0" prefWidth="720" maxWidth="720">
		            	<padding>
						    <Insets top="15" right="15" bottom="15" left="20"/>
						</padding>
		               <children>
		                  <Label text="Buscar" />
		                  <TextField fx:id="txtBuscar" promptText="Buscar por referencia o nombre" />
		                  <TabPane prefWidth="820" prefHeight="700">
		                  <tabs>
		                   <Tab text="Colección" closable="false">
		                    <content>
		                        <TableView fx:id="tablaPlaymobil" VBox.vgrow="ALWAYS">
		                            <columns>
		                                <TableColumn fx:id="colReferencia" text="Referencia" prefWidth="90"/>
		                                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="140"/>
		                                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
		                                <TableColumn fx:id="colPrecio" text="Compra" prefWidth="80"/>
		                                <TableColumn fx:id="colValor" text="Valor" prefWidth="80"/>
		                                <TableColumn fx:id="colObservaciones" text="Observaciones" prefWidth="250"/>		                           
		                            </columns>
		                        </TableView>
		                    </content>
		                </Tab>
		                		<Tab text="Estadísticas" closable="false">
		                    		<content>
		                        		<PieChart fx:id="graficoCategorias" legendVisible="true" labelsVisible="true"/>
		                    		</content>
		                		</Tab>
		            		</tabs>
		        		</TabPane>
		    		</children>
		    	</VBox>
		            <VBox prefWidth="500" maxWidth="500" spacing="15">
		               <children>
		                  <Label text="Datos del Playmobil" />
		                  <HBox spacing="15">
    						<children>
        						<VBox HBox.hgrow="ALWAYS">
									<children>
						                <Label text="Referencia"/>
						                <TextField fx:id="txtReferencia"/>
						            </children>
        						</VBox>
								<VBox HBox.hgrow="ALWAYS">
						            <children>
						                <Label text="Categoría"/>
						                <ComboBox fx:id="cmbCategoria"
						                          maxWidth="Infinity"/>
						            </children>
       							 </VBox>
							</children>
						</HBox>
						<HBox spacing="15">						
						    <children>						
						        <VBox HBox.hgrow="ALWAYS">						
						            <children>
						                <Label text="Precio compra"/>
						                <TextField fx:id="txtPrecioCompra"/>
						            </children>						
						        </VBox>						
						        <VBox HBox.hgrow="ALWAYS">						
						            <children>
						                <Label text="Valor actual"/>
						                <TextField fx:id="txtValorActual"/>
						            </children>						
						        </VBox>						
						    </children>						
						</HBox>
						  <Label text="Nombre"/>
						  <TextField fx:id="txtNombre"/>		                
		                  <Label text="Observaciones" />
		                  <TextArea fx:id="txtObservaciones" prefHeight="140.0" wrapText="true"/>
		                  <Label text="Imagen"/>
							<VBox alignment="CENTER" spacing="10">							
							    <children>							
							        <ImageView
							            fx:id="imgPlaymobil"
							            fitWidth="250"
							            fitHeight="220"							            
							            preserveRatio="true"
							            pickOnBounds="true"
							            onMouseClicked="#ampliarImagen"/>														       														            						
							         <Button
							            fx:id="btnSeleccionarImagen"
							            text="Seleccionar imagen"
							            onAction="#seleccionarImagen"/>														           													       						
							    </children>						
							</VBox>
		                  <HBox alignment="CENTER" spacing="20.0">
		                     <children>
		                        <Button fx:id="btnGuardar" alignment="CENTER" mnemonicParsing="false" onAction="#guardarPlaymobil" styleClass="btn-guardar" text="Guardar" />
		                        <Button fx:id="btnModificar" alignment="CENTER" mnemonicParsing="false" onAction="#modificarPlaymobil" styleClass="btn-modificar" text="Modificar" />
		                        <Button fx:id="btnEliminar" alignment="CENTER" mnemonicParsing="false" onAction="#eliminarPlaymobil" styleClass="btn-eliminar" text="Eliminar" />
		                     </children>
		                  </HBox>
		               </children>
		               <padding>
		                  <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
		               </padding>
		            </VBox>
		         </children>
		      </HBox>
		   </center>
		   <top>
		    <VBox alignment="CENTER" spacing="15" BorderPane.alignment="CENTER">
		
		        <children>
		
		            <Label text="PLAYMOBIL MANAGER">
		                <font>
		                    <Font name="System Bold" size="18.0" />
		                </font>
		            </Label>
		
		            <HBox alignment="CENTER" spacing="20">
		
		                <VBox styleClass="card-estadistica">
		                    <Label text="📦 Total" />
		                    <Label fx:id="lblTotalPlaymobil" styleClass="valor-estadistica" text="0" />
		                </VBox>
		
		                <VBox styleClass="card-estadistica">
		                    <Label text="💰 Compra" />
		                    <Label fx:id="lblCompra" styleClass="valor-estadistica" text="0 €" />
		                </VBox>
		
		                <VBox styleClass="card-estadistica">
		                    <Label text="📈 Valor" />
		                    <Label fx:id="lblValorActual" styleClass="valor-estadistica" text="0 €" />
		                </VBox>
		
		                <VBox styleClass="card-estadistica">
		                    <Label text="💵 Beneficio" />
		                    <Label fx:id="lblBeneficio" styleClass="valor-estadistica" text="0 €" />
		                </VBox>
		                
		                <VBox styleClass="card-estadistica">
						    <Label text="📂 Categorías" />
						    <Label fx:id="lblCategorias" styleClass="valor-estadistica" text="0" />
						</VBox>
		            </HBox>
		        </children>
		    </VBox>
		</top>		
	</BorderPane>