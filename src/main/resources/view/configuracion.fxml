<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15"
      alignment="TOP_LEFT"
      prefWidth="500"
      prefHeight="300"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ConfiguracionController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <Label text="Configuración"
               styleClass="titulo-configuracion"/>

        <Label text="Carpeta de copias de seguridad"/>

        <HBox spacing="10">
            <children>

                <TextField fx:id="txtCarpetaBackups"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Examinar"
                        onAction="#seleccionarCarpeta"/>

            </children>
        </HBox>

        <CheckBox fx:id="chkConfirmarEliminar"
                  text="Pedir confirmación antes de eliminar"/>

        <CheckBox fx:id="chkConfirmarRestaurar"
                  text="Pedir confirmación antes de restaurar"/>

        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <children>

                <Button text="Cancelar"
                        onAction="#cerrar"/>

                <Button text="Guardar"
                        onAction="#guardar"/>

            </children>
        </HBox>
    </children>
</VBox>